# Copy to .env and change the secrets. Only .env.example is committed.

# Postgres (control + lake databases)
DBK_PG_USER=duckbricks
DBK_PG_PASSWORD=change-me
DBK_PG_PORT=5433

# SeaweedFS S3 API
DBK_S3_ACCESS_KEY=duckbricks
DBK_S3_SECRET_KEY=change-me-too
DBK_S3_ENDPOINT=127.0.0.1:8333

# API
DBK_API_PORT=8080
DBK_HOST=http://127.0.0.1:8080
DBK_TOKEN=change-me-token

# The single platform user (workspace.current_user.userName). `make env` uses your git email.
DBK_USER_NAME=user@duckbricks.local

# SQL warehouses (Quack) and notebooks (marimo)
DBK_WAREHOUSE_TOKEN=change-me-warehouse
DBK_NOTEBOOKS_PORT=2718
DBK_NOTEBOOKS_TOKEN=change-me-notebooks

# Optional: a Databricks workspace for live federation and the mirror (ADR 0013).
# The token needs EXTERNAL USE SCHEMA on every schema read through credential vending.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
